# Telegram
BOT_TOKEN=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=2

# Storage
DB_PATH=bot.db

# Personality / autonomy
AUTO_REPLY_CHANCE=0.50
CREATIVITY=0.64
MIN_MESSAGES_FOR_AUTO_REPLY=10
AUTO_COOLDOWN_SECONDS=25
AI_CHECK_COOLDOWN_SECONDS=6
AUTO_DELAY_MIN_SECONDS=18
AUTO_DELAY_MAX_SECONDS=45
SHORT_REACTION_CHANCE=0.28

# Idle interventions
IDLE_SCAN_INTERVAL_SECONDS=180
IDLE_MIN_SILENCE_SECONDS=300
IDLE_MAX_SILENCE_SECONDS=7200
IDLE_COOLDOWN_SECONDS=900
IDLE_INTERVENTION_CHANCE=0.22

# Demotivators
AUTO_DEMOTIVATORS_ENABLED=true
AUTO_DEMOTIVATOR_CHANCE=0.10
AUTO_DEMOTIVATOR_IDLE_CHANCE=0.18
AUTO_DEMOTIVATOR_COOLDOWN_SECONDS=3600
AUTO_DEMOTIVATOR_MIN_PHOTOS=6

# Memory
CONTEXT_MESSAGES=30
STYLE_EXAMPLES=16
GROUP_MEMORY_EXAMPLES=14
MAX_STORED_MESSAGES=10000
MAX_CONVERSATION_LOG=20000
GROUP_MEMORY_MAX_PER_CHAT=3000
MAX_USER_MEMORY_CARDS=50
MEMORY_CURATOR_ENABLED=true

# Telegram behaviour
REACTIONS_ENABLED=true
BOT_NAME_ALIASES=мёмоч,мемоч,memochka
LOG_LEVEL=INFO
